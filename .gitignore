# Environment variables and secrets
.env
.env.*
!.env.example

# Python runtime and caches
.venv/
.venv-*/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Local dependency copies
vendor_packages/

# Runtime data, databases, and parsed-document cache
data/*
!data/.gitkeep
*.db
*.db-shm
*.db-wal
document_payloads/

# Local AI/OCR/document models
models/

# Local sample or user data
demo_data/

# Generated reports, ZIP archives, logs, and temporary files
outputs/*
!outputs/.gitkeep
logs/
.logs/
.cache/
.tmp/
.temp/

# Local backups and working files
work/
.codex-backups/
.codex*/
*.codex-backup-*
*.codex-pre-*
*.pre-large-*
*.predeploy-*
wx/
*.bak*
*.pre_*
*_old.txt
*_tmp.py
.gitignore.save
.gitignore.save.*

# Local smoke packages and copied benchmark artifacts. These are useful for
# server-side verification but are neither source nor distributable fixtures.
/benchmark-vllm-2.2.1/
/benchmark-vllm-2.2.1-r1/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~

# Server-side emergency backups
backups/

# Server-side snapshots and bounded audit captures; never publish these copies.
.codex_*
*.pre-audit-*

# ---------------------------------------------------------------------------
# Server-side captures, real user samples and packaged third-party binaries.
# These are environment artifacts produced on this machine, not source code;
# they must never be published.
# ---------------------------------------------------------------------------
/benchmark_capture/
/gzy_test/
/.tools/
/services/mail/_ocr/

# In-place edit backups of tracked sources
/app.py.pre-*
/templates/*.pre-*
/concurrency-changes.patch

# Stray files created by a mis-quoted shell command
/n' '---*
