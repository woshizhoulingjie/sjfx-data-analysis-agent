# Local model is the default. Document content never goes to a cloud model
# unless both LLM_BACKEND and ENABLE_CLOUD_FEATURES explicitly allow it.
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen-agent:latest
OLLAMA_EMBED_MODEL=qwen-embed:latest
LLM_MAX_CONCURRENCY=1

# Keep these disabled on a shared laboratory Ollama unless its owner has agreed.
ENABLE_SHARED_OLLAMA=0
ENABLE_SHARED_OLLAMA_EMBEDDINGS=0
SHARED_OLLAMA_REQUEST_TIMEOUT=600
SHARED_OLLAMA_MAX_CHARS=48000

# Optional cloud backend. Never commit a real key.
ENABLE_CLOUD_FEATURES=0
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MAX_CLOUD_REQUESTS=3

# Web and access control. If HOST is not loopback, enable authentication.
HOST=127.0.0.1
PORT=8000
AUTH_REQUIRED=0
SJFX_API_ACCESS_TOKEN=replace-with-a-long-random-token

# Linux uses ':' to separate multiple allowed roots.
SCAN_ALLOWED_ROOTS=/home/your-user/datasets

# Bounded scanning, parsing and analysis.
MAX_EXTRACT_CHARS=60000
MAX_FULL_DOCUMENT_CHARS=2000000
MAX_DOCUMENT_CHUNKS=12
MAX_SINGLE_FILE_BYTES=10737418240
MAX_PARSE_SECONDS=300
MAX_WORKER_MEMORY_MB=8192
MAX_SCAN_DEPTH=32
MAX_SCAN_FILES=50000
MAX_ANALYSIS_JOBS=1

# Safe archive extraction boundaries.
MAX_ARCHIVE_ENTRIES=1500
MAX_ARCHIVE_MEMBER_BYTES=134217728
MAX_ARCHIVE_UNCOMPRESSED_BYTES=2147483648

# Structured data and export boundaries.
MAX_STRUCTURED_PROFILE_ROWS=100000
MAX_STRUCTURED_PROFILE_BYTES=268435456
MAX_EXPORT_BYTES=5368709120

# Large-package policy.
LARGE_PACKAGE_THRESHOLD_BYTES=1073741824
LARGE_PACKAGE_THRESHOLD_FILES=3000
LARGE_PACKAGE_INITIAL_PARSE_FILES=700
LARGE_PACKAGE_DEEPEN_BATCH_FILES=500
LARGE_PACKAGE_OVERVIEW_CHARS_PER_FILE=30000

# Worker polling and abandoned-task recovery.
WORKER_POLL_SECONDS=0.5
WORKER_STALE_SECONDS=900
