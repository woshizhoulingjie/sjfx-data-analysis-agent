DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Keep cloud document transmission disabled on isolated laboratory hosts.
ENABLE_CLOUD_FEATURES=0
ENABLE_SHARED_OLLAMA_EMBEDDINGS=0
OLLAMA_EMBED_MODEL=qwen-embed:latest
HOST=127.0.0.1
PORT=8000
MAX_EXTRACT_CHARS=60000
MAX_FULL_DOCUMENT_CHARS=2000000
MAX_DOCUMENT_CHUNKS=12
MAX_ANALYSIS_JOBS=1
MAX_CLOUD_REQUESTS=3

# Security and bounded analysis
SJFX_API_ACCESS_TOKEN=replace-with-long-random-token
AUTH_REQUIRED=0
SCAN_ALLOWED_ROOTS=/home/nas511/zhoulingjie
MAX_SINGLE_FILE_BYTES=10737418240
MAX_PARSE_SECONDS=300
MAX_WORKER_MEMORY_MB=8192
MAX_SCAN_DEPTH=32
MAX_SCAN_FILES=50000
MAX_ARCHIVE_ENTRIES=1500
MAX_ARCHIVE_MEMBER_BYTES=134217728
MAX_ARCHIVE_UNCOMPRESSED_BYTES=2147483648
MAX_STRUCTURED_PROFILE_ROWS=100000
MAX_STRUCTURED_PROFILE_BYTES=268435456
MAX_EXPORT_BYTES=5368709120
