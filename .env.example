# Local-only model configuration. All document content stays on this host.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen-agent:latest
OLLAMA_EMBED_MODEL=qwen-embed:latest
LLM_MAX_CONCURRENCY=1

# Shared Ollama safety switches.
ENABLE_SHARED_OLLAMA=0
ENABLE_SHARED_OLLAMA_EMBEDDINGS=0
SHARED_OLLAMA_REQUEST_TIMEOUT=600
SHARED_OLLAMA_MAX_CHARS=48000
LLM_CONTEXT_TOKENS=65536

# Dedicated local translation pipeline (may reuse the same Ollama service/model).
ENABLE_TRANSLATION=1
ENABLE_TRANSLATION_REVIEW=1
TRANSLATION_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
TRANSLATION_OLLAMA_MODEL=qwen-agent:latest
TRANSLATION_MAX_UNIT_CHARS=2400
TRANSLATION_MAX_ATTEMPTS=3
TRANSLATION_TIMEOUT_SECONDS=180
TRANSLATION_PACKAGE_BATCH_FILES=50
TRANSLATION_FOREGROUND_MAX_UNITS=24
AUTO_TRANSLATE_PACKAGES=1

# Web and access control.
HOST=127.0.0.1
PORT=8000
AUTH_REQUIRED=0
SJFX_API_ACCESS_TOKEN=replace-with-a-long-random-token
# Stable data owner. Rotate the API token without changing this value, or old
# scans/jobs/artifacts will intentionally remain under the previous owner.
SJFX_OWNER_ID=primary
# Optional UTC epoch/ISO expiry; empty means manual rotation only.
SJFX_API_TOKEN_EXPIRES_AT=
# One-use browser download URL lifetime. Large exports stream directly to disk
# and are never buffered as a browser Blob.
DOWNLOAD_TICKET_TTL_SECONDS=120
# Keep SQLite/WAL and private sidecars on local ext4/xfs, not NFS. When this
# project itself is on NFS, the application first uses the local durable
# ~/.local/state directory and falls back to a private /var/tmp directory only
# when the home filesystem is also remote.
# SJFX_STATE_DIR=/var/lib/sjfx-data-analysis-agent
# Use a dedicated local volume with room for a near-10-GiB expansion. Never
# point this at a small system /tmp on the production server.
SJFX_PARSE_TEMP_DIR=/var/tmp/sjfx-data-analysis-agent-parse
PARSE_TEMP_DISK_RESERVE_BYTES=1073741824
PARSE_TEMP_STALE_SECONDS=21600

# Linux uses ':' to separate multiple narrowly scoped roots. When HOST is not
# loopback this setting is mandatory; never expose an entire /home tree.
SCAN_ALLOWED_ROOTS=/home/your-user/datasets
# Empty by default: a complete forensic inventory does not silently omit
# ordinary/hidden/unsupported/sensitive entries. Explicit exclusions are
# visible policy decisions and make inventory_coverage.complete=false.
SCAN_IGNORED_DIRS=
SCAN_IGNORED_FILES=

# Bounded scanning, parsing and analysis.
MAX_EXTRACT_CHARS=60000
MAX_FULL_DOCUMENT_CHARS=2000000
MAX_DOCUMENT_CHUNKS=64
# One audited binary 10-GiB ceiling shared by each individual content object.
# Component values below may lower their own budget but cannot raise this cap.
MAX_CONTENT_BYTES=10737418240
MAX_SINGLE_FILE_BYTES=10737418240
MAX_PARSE_SECONDS=600
# Only used after the deep parser reaches MAX_PARSE_SECONDS.
MAX_PARSE_FALLBACK_SECONDS=300
MAX_WORKER_MEMORY_MB=8192
MAX_PARSE_PROCESS_MEMORY_MB=8192
ENABLE_PARSE_PROCESS_ISOLATION=1
# Optional: spawn is safer after CUDA/PyTorch warm-up; Linux default is fork.
SJFX_PARSE_START_METHOD=fork
# Docling/OCR defaults to CPU so it never competes with the local Qwen GPU.
DOCLING_DEVICE=cpu
DOCLING_CPU_THREADS=4
# Defaults are safety boundaries, not a promise to ignore the remainder. For a
# larger package raise file/directory/node budgets together after measurement;
# hitting any boundary makes inventory_coverage.complete=false.
MAX_SCAN_DEPTH=32
MAX_SCAN_FILES=50000
MAX_SCAN_DIRECTORIES=50000
MAX_SCAN_NODES=100001
MAX_SCAN_ENTRIES_PER_DIRECTORY=50000
MAX_ANALYSIS_JOBS=1
# Preview every inventoried file in bounded batches; only representatives and
# question/translation hits enter accurate parsing. Each result is checkpointed.
LARGE_PACKAGE_BATCH_FILES=500

# Safe archive extraction boundaries.
MAX_ARCHIVE_ENTRIES=5000
MAX_ARCHIVE_FILE_BYTES=10737418240
MAX_ARCHIVE_MEMBER_BYTES=10737418240
MAX_ARCHIVE_UNCOMPRESSED_BYTES=10737418240
MAX_ARCHIVE_COMPRESSION_RATIO=200
MAX_ARCHIVE_MEMBER_PATH_DEPTH=32

# Structured data and export boundaries.
MAX_STRUCTURED_PROFILE_ROWS=100000
MAX_STRUCTURED_PROFILE_BYTES=268435456
# Per-record guard for a single huge JSON/JSONL value (16 MiB by default).
MAX_STRUCTURED_JSON_RECORD_BYTES=16777216
MAX_STRUCTURED_JSON_RECORD_CHARS=16777216
MAX_EXPORT_BYTES=10737418240
EXPORT_DISK_RESERVE_BYTES=1073741824

# SQLite/WAL safety (the Worker periodically checkpoints the WAL file).
SJFX_SQLITE_BUSY_TIMEOUT_MS=30000
SJFX_SQLITE_WAL_AUTOCHECKPOINT=1000
SJFX_SQLITE_JOURNAL_SIZE_LIMIT=67108864
SJFX_SQLITE_CHECKPOINT_INTERVAL=60

# Large-package policy.
LARGE_PACKAGE_THRESHOLD_BYTES=1073741824
LARGE_PACKAGE_THRESHOLD_FILES=3000
LARGE_PACKAGE_INITIAL_PARSE_FILES=700
LARGE_PACKAGE_DEEPEN_BATCH_FILES=500
LARGE_PACKAGE_PREVIEW_BYTES_PER_FILE=98304
LARGE_PACKAGE_PREVIEW_TOTAL_BYTES=8589934592
LARGE_PACKAGE_PREVIEW_ZIP_MEMBERS=80
LARGE_PACKAGE_PREVIEW_ZIP_MEMBER_BYTES=8192
LARGE_PACKAGE_OVERVIEW_CHARS_PER_FILE=4000
LARGE_PACKAGE_OVERVIEW_EVIDENCE_PER_FILE=6

# Worker polling and abandoned-task recovery.
WORKER_POLL_SECONDS=0.5
WORKER_MONITOR_SECONDS=0.5
WORKER_HEARTBEAT_SECONDS=3
WORKER_TERMINATE_GRACE_SECONDS=5
WORKER_STALE_SECONDS=900
# Total task runtime guards. Package analysis/export remain suitable for large
# datasets, while an interactive model summary cannot occupy the queue forever.
JOB_DEFAULT_TIMEOUT_SECONDS=3600
JOB_SCAN_TIMEOUT_SECONDS=86400
JOB_ANALYSIS_TIMEOUT_SECONDS=86400
JOB_SUMMARY_TIMEOUT_SECONDS=420
JOB_DOCUMENT_SUMMARY_TIMEOUT_SECONDS=1800
JOB_REPORT_TIMEOUT_SECONDS=900
JOB_EXPORT_TIMEOUT_SECONDS=21600
JOB_TRANSLATION_TIMEOUT_SECONDS=7200
JOB_TRANSLATION_PACKAGE_TIMEOUT_SECONDS=86400
# Long scan/analysis tasks automatically continue from checkpoints in a fresh
# supervised process after each runtime slice.
MAX_JOB_RESUME_ATTEMPTS=64
