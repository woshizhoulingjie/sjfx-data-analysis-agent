[Unit]
Description=SJFX Data Analysis Agent Web API
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=zhoulingjie
Group=gpuuser
WorkingDirectory=/home/nas511/zhoulingjie/sjfx
EnvironmentFile=/var/lib/sjfx-data-analysis-agent/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/nas511/zhoulingjie/sjfx/.venv/bin/python -u app.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group

UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

StateDirectory=sjfx-data-analysis-agent
StateDirectoryMode=0700
ReadWritePaths=/home/nas511/zhoulingjie/sjfx/outputs
MemoryMax=4G
TasksMax=256

[Install]
WantedBy=multi-user.target
