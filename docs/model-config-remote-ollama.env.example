# Merge into a private instance environment. Start and load Ollama separately.
# Replace this example address with the customer LAN or selected server address.
# Model request contents will be sent to the explicitly selected service.
SJFX_MODEL_ALLOWED_ENDPOINTS=["http://192.168.10.20:11434"]
LLM_BACKEND=ollama
ENABLE_SHARED_OLLAMA=1
OLLAMA_BASE_URL=http://192.168.10.20:11434
OLLAMA_MODEL=your-loaded-chat-model
OLLAMA_API_KEY=
SHARED_OLLAMA_REQUEST_TIMEOUT=180
LLM_CONTEXT_TOKENS=4096
LLM_MAX_CONCURRENCY=1
LLM_TOKENIZER_PATH=
LLM_TOKENIZER_VERSION=
LLM_MODEL_VERSION=
SJFX_EMBED_BACKEND=ollama
SJFX_EMBED_BASE_URL=http://192.168.10.20:11434
SJFX_EMBED_MODEL=your-loaded-embedding-model
SJFX_EMBED_API_KEY=
SJFX_EMBED_ENCODING=plain
SJFX_EMBED_TOKENIZER_PATH=
SJFX_EMBED_DIMENSION=0
SJFX_EMBED_VERSION=deployment-v1
SJFX_EMBED_WEIGHTS_ID=
SJFX_EMBED_CONFIG_ID=
VLLM_EMBED_TIMEOUT_SECONDS=20
SJFX_LP_EMBED_CONCURRENCY=1
SJFX_LP_EMBED_BASE_URL=http://192.168.10.20:11434
MAIL_EMBED_BASE_URL=http://192.168.10.20:11434
MAIL_EMBED_MODEL=your-loaded-embedding-model
SJFX_LP_EMBED_FALLBACK_URL=
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
