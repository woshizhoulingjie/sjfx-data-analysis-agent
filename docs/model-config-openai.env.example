# Merge into a private, separate instance env created by sjfxctl setup.
# Loopback refers to the SJFX application machine. Keep credentials private.
# For a different model machine, use its reachable HTTP(S) URL and add its exact
# origin to SJFX_MODEL_ALLOWED_ENDPOINTS, or save the URL in the admin settings UI.
LLM_BACKEND=openai_compatible
ENABLE_OPENAI_COMPATIBLE=1
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8001/v1
OPENAI_COMPATIBLE_MODEL=your-loaded-chat-model
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_REQUEST_TIMEOUT=180
OPENAI_COMPATIBLE_SUPPORTS_JSON_RESPONSE_FORMAT=0
LLM_CONTEXT_TOKENS=4096
# Use only a tokenizer matching the selected chat model; empty uses byte bounds.
LLM_TOKENIZER_PATH=
LLM_TOKENIZER_VERSION=
LLM_MODEL_VERSION=
LLM_MAX_CONCURRENCY=1
LLM_QUEUE_TIMEOUT_SECONDS=15
SJFX_EMBED_BACKEND=openai_compatible
SJFX_EMBED_BASE_URL=http://127.0.0.1:8002/v1
SJFX_EMBED_MODEL=your-loaded-embedding-model
SJFX_EMBED_API_KEY=
SJFX_EMBED_VERSION=deployment-v1
SJFX_EMBED_WEIGHTS_ID=your-offline-weight-release
SJFX_EMBED_CONFIG_ID=plain-or-e5-policy-release
SJFX_EMBED_DIMENSION=0
SJFX_EMBED_ENCODING=plain
SJFX_EMBED_TOKENIZER_PATH=
VLLM_EMBED_TIMEOUT_SECONDS=12
SJFX_LP_EMBED_CONCURRENCY=1
# Admin embedding saves unify mail/large endpoints and remove a legacy fallback.
SJFX_LP_EMBED_FALLBACK_URL=
# If using SJFX's bundled CPU embedding server, explicitly point at installed weights.
# Windows: SJFX_EMBED_MODEL_PATH=D:/SJFX/models/multilingual-e5-small
# Linux: SJFX_EMBED_MODEL_PATH=/data/sjfx/models/multilingual-e5-small
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
